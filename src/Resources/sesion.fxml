<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.text.*?>
<?import javafx.scene.image.*?>
<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="580.0" prefWidth="1100.0" style="-fx-background-color: #A5A583;" stylesheets="@styles/sesion.css" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ViewController.SesionController">
   <children>
      <ImageView fitHeight="150.0" fitWidth="200.0" layoutX="14.0" layoutY="14.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@Logo.png" />
         </image>
      </ImageView>
      <Text layoutX="141.0" layoutY="96.0" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="session-brand" text="Jucamer Stay" />
      <ImageView fitHeight="752.0" fitWidth="738.0" layoutX="362.0" layoutY="2.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@imagenInicioSesion.png" />
         </image>
      </ImageView>
      <AnchorPane layoutX="174.0" layoutY="164.0" prefHeight="371.0" prefWidth="370.0" style="-fx-background-color: #FDFBD4;">
         <children>
            <Text layoutX="102.0" layoutY="45.0" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="session-title" text="Inicio de Sesión" />
            <Text layoutX="75.0" layoutY="72.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Ingrese con su usuario" />
            <TextField fx:id="txtUsuario" layoutX="14.0" layoutY="110.0" />
            <Text layoutX="14.0" layoutY="99.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Usuario" />
            <Text layoutX="14.0" layoutY="181.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Contraseña" />
            <TextField fx:id="txtContrasena" layoutX="14.0" layoutY="186.0" />
            <Text layoutX="15.0" layoutY="328.0" strokeType="OUTSIDE" strokeWidth="0.0" text="¡Aun no tiene cuenta?" />
            <Button fx:id="btnCrearCuenta" layoutX="238.0" layoutY="301.0" mnemonicParsing="false" onAction="#crearCuenta" text="Crear cuenta" />
            <Button fx:id="btnIniciarSesion" layoutX="121.0" layoutY="242.0" mnemonicParsing="false" onAction="#iniciarSesion" text="Iniciar Sesión" />
         </children>
      </AnchorPane>
   </children>
</AnchorPane>
